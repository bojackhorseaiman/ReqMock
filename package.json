{
  "name": "reqmock",
  "version": "0.3.4",
  "description": "API debug client + mock server desktop tool",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron . --no-sandbox --disable-gpu\"",
    "check:css": "node tools/check-css-tokens.mjs",
    "check:wireup": "node tools/check-wireup.mjs",
    "build": "npm run check:css && npm run check:wireup && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run check:css && npm run check:wireup && vite build && electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.reqmock.app",
    "productName": "ReqMock",
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "leleworld",
        "repo": "ReqMock"
      }
    ],
    "extraResources": [{
      "from": "build/icons",
      "to": "icons"
    }],

    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@jetbrains/icons": "^5.23.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.43.0",
    "ws": "^8.21.1"
  }
}
